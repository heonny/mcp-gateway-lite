{
  "name": "mcp-gateway-lite",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "description": "A lightweight multi-adapter MCP streamable HTTP gateway for Postgres, Redis, and ClickHouse.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heonny/mcp-gateway-lite.git"
  },
  "homepage": "https://github.com/heonny/mcp-gateway-lite#readme",
  "bugs": {
    "url": "https://github.com/heonny/mcp-gateway-lite/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "postgres",
    "redis",
    "clickhouse",
    "fastify"
  ],
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "config.example.yml"
  ],
  "bin": {
    "mcp-gateway-lite": "dist/main.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts --config ./config.yml",
    "start": "node dist/main.js --config ./config.yml",
    "prepack": "pnpm build",
    "pack:check": "npm pack --dry-run",
    "publish:check": "pnpm lint && pnpm test && pnpm build && npm pack --dry-run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
